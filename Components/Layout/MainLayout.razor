@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<style>
    .page {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100vh;
    }

    main {
        flex: 1;
        overflow-y: auto;
    }

    .sidebar {
        background-image: linear-gradient(180deg, #5e3a8e 0%, #4a2c6d 70%);
    }

    .top-row {
        background-color: #f7f7f7;
        border-bottom: 1px solid #d6d5d5;
        justify-content: flex-end;
        height: 3.5rem;
        display: flex;
        align-items: center;
    }

    .top-row a {
        color: #000;
        margin-left: 1.5rem;
        text-decoration: none;
    }

    .top-row a:hover {
        text-decoration: underline;
    }

    
</style>