@inherits LayoutComponentBase
@inject ThemeService ThemeService
@inject NavigationManager Navigation

<div class="app-container @ThemeService.CurrentTheme">
    <nav class="navbar">
        <div class="nav-brand">
            <h1>📔 My Journal</h1>
        </div>
        <div class="nav-links">
            <a href="/" class="@GetNavClass("")">✏️ Write</a>
            <a href="/calendar" class="@GetNavClass("calendar")">📅 Calendar</a>
            <a href="/timeline" class="@GetNavClass("timeline")">📜 Timeline</a>
            <a href="/analytics" class="@GetNavClass("analytics")">📊 Analytics</a>
            <button class="theme-btn" @onclick="ToggleTheme">
                @(ThemeService.CurrentTheme == "light" ? "🌙" : "☀️")
            </button>
        </div>
    </nav>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
    }

    private string GetNavClass(string page)
    {
        var currentPage = Navigation.Uri.Split('/').Last();
        return currentPage == page ? "nav-link active" : "nav-link";
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}