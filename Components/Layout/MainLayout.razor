@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="app-container">
    <nav class="navbar">
        <div class="nav-left">
            <h1 class="nav-title">
                <svg width="24" height="24" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2"
                     class="logo-icon">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
                My Journal
            </h1>
        </div>
        <div class="nav-right">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">
                <svg viewBox="0 0 24 24">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                <span>Write</span>
            </NavLink>
            <NavLink href="/calendar" Match="NavLinkMatch.Prefix" class="nav-link">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>Calendar</span>
            </NavLink>
            <NavLink href="/timeline" Match="NavLinkMatch.Prefix" class="nav-link">
                <svg viewBox="0 0 24 24">
                    <line x1="12" y1="2" x2="12" y2="22"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
                <span>Timeline</span>
            </NavLink>
            <NavLink href="/analytics" Match="NavLinkMatch.Prefix" class="nav-link">
                <svg viewBox="0 0 24 24">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
                <span>Analytics</span>
            </NavLink>

            <!-- theme toggle -->
            <!-- theme toggle -->
            <button class="nav-link" @onclick="ToggleTheme" @onclick:preventDefault="true">
                @if (IsDarkMode)
                {               
                    <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
                        <path d="M9 18h6"></path>
                        <path d="M10 22h4"></path>
                        <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8a6 6 0 0 0-12 0c0 1.36.5 2.6 1.5 3.5.76.76 1.23 1.52 1.41 2.5"></path>
                        <line x1="12" y1="2" x2="12" y2="4"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="2" y1="12" x2="4" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="19.78" y1="4.22" x2="18.36" y2="5.64"></line>
                        <line x1="20" y1="12" x2="22" y2="12"></line>
                    </svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2">
                        <path d="M9 18h6"></path>
                        <path d="M10 22h4"></path>
                        <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8a6 6 0 0 0-12 0c0 1.36.5 2.6 1.5 3.5.76.76 1.23 1.52 1.41 2.5"></path>
                    </svg>
                }
            </button>
        </div>
    </nav>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private bool IsDarkMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Checks if the page is in dark mode by reading the root class
            var rootClass = await JS.InvokeAsync<string>("eval", "document.documentElement.className");
            IsDarkMode = rootClass.Contains("dark");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        IsDarkMode = !IsDarkMode;
        var theme = IsDarkMode ? "dark" : "light";

        //Applies theme by calling JS function
        await JS.InvokeVoidAsync("applyTheme", theme);
    }
}
