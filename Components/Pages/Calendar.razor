@page "/calendar"
@inject JournalService JournalService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Calendar - My Journal</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
    return;
}

<div class="calendar-container">
    <div class="calendar-header">
        <button class="btn btn-secondary" @onclick="PreviousMonth">◀</button>
        <h2>@currentMonth.ToString("MMMM yyyy")</h2>
        <button class="btn btn-secondary" @onclick="NextMonth">▶</button>
    </div>

    <div class="calendar-grid">
        <div class="calendar-day-header">Sun</div>
        <div class="calendar-day-header">Mon</div>
        <div class="calendar-day-header">Tue</div>
        <div class="calendar-day-header">Wed</div>
        <div class="calendar-day-header">Thu</div>
        <div class="calendar-day-header">Fri</div>
        <div class="calendar-day-header">Sat</div>

        @foreach (var day in GetCalendarDays())
        {
            <div class="calendar-day @GetDayClass(day)" @onclick="() => SelectDay(day)">
                <div class="day-number">@day.Day</div>
                @if (HasEntry(day))
                {
                    <div class="day-indicator">📔</div>
                    <div class="day-mood">@GetMoodEmoji(day)</div>
                }
            </div>
        }
    </div>

    @if (selectedEntry != null)
    {
        <div class="entry-preview">
            <div class="preview-header">
                <h3>@selectedEntry.Date.ToString("MMMM d, yyyy")</h3>
                <button class="btn btn-secondary" @onclick="ClosePreview">✕</button>
            </div>
            <h4>@selectedEntry.Title</h4>
            <div class="preview-mood">
                <strong>Mood:</strong> @selectedEntry.PrimaryMood
                @if (!string.IsNullOrEmpty(selectedEntry.SecondaryMood1))
                {
                    <span>, @selectedEntry.SecondaryMood1</span>
                }
                @if (!string.IsNullOrEmpty(selectedEntry.SecondaryMood2))
                {
                    <span>, @selectedEntry.SecondaryMood2</span>
                }
            </div>
            @if (selectedEntry.GetTags().Any())
            {
                <div class="preview-tags">
                    @foreach (var tag in selectedEntry.GetTags())
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            }
            <div class="preview-content">@((MarkupString)selectedEntry.Content)</div>
            <div class="preview-meta">
                @selectedEntry.WordCount words • Created @selectedEntry.CreatedAt.ToString("g")
            </div>
        </div>
    }
</div>

@code {
    private DateTime currentMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<JournalEntry> entries = new();
    private JournalEntry? selectedEntry;

    protected override async Task OnInitializedAsync()
    {
        await LoadEntries();
    }

    private async Task LoadEntries()
    {
        var startDate = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        var endDate = startDate.AddMonths(1).AddDays(-1);
        entries = await JournalService.GetEntriesInRangeAsync(startDate, endDate);
    }

    private List<DateTime> GetCalendarDays()
    {
        var days = new List<DateTime>();
        var firstDay = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);

        // Add days from previous month
        var firstDayOfWeek = (int)firstDay.DayOfWeek;
        for (int i = firstDayOfWeek - 1; i >= 0; i--)
        {
            days.Add(firstDay.AddDays(-i - 1));
        }

        // Add days from current month
        for (var day = firstDay; day <= lastDay; day = day.AddDays(1))
        {
            days.Add(day);
        }

        // Add days from next month
        var lastDayOfWeek = (int)lastDay.DayOfWeek;
        for (int i = 1; i <= 6 - lastDayOfWeek; i++)
        {
            days.Add(lastDay.AddDays(i));
        }

        return days;
    }

    private string GetDayClass(DateTime day)
    {
        var classes = new List<string>();

        if (day.Month != currentMonth.Month)
            classes.Add("other-month");

        if (day.Date == DateTime.Today)
            classes.Add("today");

        if (HasEntry(day))
            classes.Add("has-entry");

        return string.Join(" ", classes);
    }

    private bool HasEntry(DateTime day)
    {
        return entries.Any(e => e.Date.Date == day.Date);
    }

    private string GetMoodEmoji(DateTime day)
    {
        var entry = entries.FirstOrDefault(e => e.Date.Date == day.Date);
        if (entry == null) return "";

        return entry.GetMoodCategory() switch
        {
            MoodCategory.Positive => "😊",
            MoodCategory.Neutral => "😐",
            MoodCategory.Negative => "😔",
            _ => ""
        };
    }

    private async Task SelectDay(DateTime day)
    {
        if (day.Month != currentMonth.Month) return;

        selectedEntry = await JournalService.GetEntryByDateAsync(day);
    }

    private void ClosePreview()
    {
        selectedEntry = null;
    }

    private async Task PreviousMonth()
    {
        currentMonth = currentMonth.AddMonths(-1);
        await LoadEntries();
        selectedEntry = null;
    }

    private async Task NextMonth()
    {
        currentMonth = currentMonth.AddMonths(1);
        await LoadEntries();
        selectedEntry = null;
    }
}