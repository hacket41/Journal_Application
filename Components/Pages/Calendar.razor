@page "/calendar"

<PageTitle>Calendar View</PageTitle>

<div class="calendar-page">
    <div class="calendar-header">
        <h1>Calendar View</h1>
        <p>Navigate through your journal entries by date</p>
    </div>

    <div class="calendar-container">
        <div class="calendar-nav">
            <button class="nav-btn">‹ Previous</button>
            <h2>December 2025</h2>
            <button class="nav-btn">Next ›</button>
        </div>

        <div class="calendar-grid">
            <div class="calendar-weekday">Sun</div>
            <div class="calendar-weekday">Mon</div>
            <div class="calendar-weekday">Tue</div>
            <div class="calendar-weekday">Wed</div>
            <div class="calendar-weekday">Thu</div>
            <div class="calendar-weekday">Fri</div>
            <div class="calendar-weekday">Sat</div>

            <!-- Previous month days -->
            <div class="calendar-day other-month">24</div>
            <div class="calendar-day other-month">25</div>
            <div class="calendar-day other-month">26</div>
            <div class="calendar-day other-month">27</div>
            <div class="calendar-day other-month">28</div>
            <div class="calendar-day other-month">29</div>
            <div class="calendar-day other-month">30</div>

            <!-- Current month days -->
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">1</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">2</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day has-entry mood-neutral">
                <span class="day-number">3</span>
                <div class="mood-indicator mood-neutral"></div>
            </div>
            <div class="calendar-day">
                <span class="day-number">4</span>
            </div>
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">5</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day has-entry mood-negative">
                <span class="day-number">6</span>
                <div class="mood-indicator mood-negative"></div>
            </div>
            <div class="calendar-day has-entry mood-neutral">
                <span class="day-number">7</span>
                <div class="mood-indicator mood-neutral"></div>
            </div>
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">8</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">9</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day">
                <span class="day-number">10</span>
            </div>
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">11</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day has-entry mood-neutral">
                <span class="day-number">12</span>
                <div class="mood-indicator mood-neutral"></div>
            </div>
            <div class="calendar-day has-entry mood-negative">
                <span class="day-number">13</span>
                <div class="mood-indicator mood-negative"></div>
            </div>
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">14</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">15</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day">
                <span class="day-number">16</span>
            </div>
            <div class="calendar-day has-entry mood-neutral">
                <span class="day-number">17</span>
                <div class="mood-indicator mood-neutral"></div>
            </div>
            <div class="calendar-day has-entry mood-positive">
                <span class="day-number">18</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day current-day has-entry mood-positive">
                <span class="day-number">19</span>
                <div class="mood-indicator mood-positive"></div>
            </div>
            <div class="calendar-day">
                <span class="day-number">20</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">21</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">22</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">23</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">24</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">25</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">26</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">27</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">28</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">29</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">30</span>
            </div>
            <div class="calendar-day">
                <span class="day-number">31</span>
            </div>

            <!-- Next month days -->
            <div class="calendar-day other-month">1</div>
            <div class="calendar-day other-month">2</div>
            <div class="calendar-day other-month">3</div>
            <div class="calendar-day other-month">4</div>
        </div>

        <div class="calendar-legend">
            <div class="legend-item">
                <div class="legend-color mood-positive"></div>
                <span>Positive Mood</span>
            </div>
            <div class="legend-item">
                <div class="legend-color mood-neutral"></div>
                <span>Neutral Mood</span>
            </div>
            <div class="legend-item">
                <div class="legend-color mood-negative"></div>
                <span>Negative Mood</span>
            </div>
            <div class="legend-item">
                <div class="legend-color no-entry"></div>
                <span>No Entry</span>
            </div>
        </div>
    </div>

    <div class="entry-preview">
        <h3>December 19, 2025</h3>
        <div class="preview-card">
            <div class="preview-header">
                <span class="preview-mood">Relaxed</span>
                <span class="preview-time">Updated at 3:45 PM</span>
            </div>
            <h4>A Peaceful Thursday</h4>
            <p class="preview-content">
                Today was incredibly peaceful. I took some time to meditate in the morning,
                which really set the tone for the rest of the day...
            </p>
            <div class="preview-tags">
                <span class="tag">Meditation</span>
                <span class="tag">Self-care</span>
                <span class="tag">Reflection</span>
            </div>
            <button class="btn-view">View Full Entry →</button>
        </div>
    </div>
</div>

