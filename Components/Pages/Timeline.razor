@page "/timeline"
@inject JournalService JournalService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Timeline - My Journal</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
    return;
}

<div class="timeline-container">
    <div class="timeline-header">
        <h2>Journal Timeline</h2>
        <button class="btn btn-secondary" @onclick="ToggleFilters">🔍 Filters</button>
    </div>

    @if (showFilters)
    {
        <div class="filters-panel">
            <div class="filter-row">
                <div class="form-group">
                    <label>Search</label>
                    <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="ApplyFilters" class="form-input" placeholder="Search title or content..." />
                </div>
            </div>

            <div class="filter-row">
                <div class="form-group">
                    <label>Start Date</label>
                    <input type="date" @bind="startDate" class="form-input" />
                </div>

                <div class="form-group">
                    <label>End Date</label>
                    <input type="date" @bind="endDate" class="form-input" />
                </div>
            </div>

            <div class="filter-row">
                <div class="form-group">
                    <label>Moods</label>
                    <select @bind="selectedMoodFilter" class="form-select">
                        <option value="">All Moods</option>
                        @foreach (var mood in MoodDefinitions.GetAllMoods())
                        {
                            <option value="@mood">@mood</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Tags</label>
                    <select @bind="selectedTagFilter" class="form-select">
                        <option value="">All Tags</option>
                        @foreach (var tag in allTags)
                        {
                            <option value="@tag">@tag</option>
                        }
                    </select>
                </div>
            </div>

            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="ApplyFilters">Apply Filters</button>
                <button class="btn btn-secondary" @onclick="ClearFilters">Clear</button>
            </div>
        </div>
    }

    <div class="entries-list">
        @if (displayedEntries.Any())
        {
            @foreach (var entry in displayedEntries)
            {
                <div class="timeline-entry">
                    <div class="entry-date">@entry.Date.ToString("MMM d, yyyy")</div>
                    <div class="entry-card">
                        <h3>@(string.IsNullOrEmpty(entry.Title) ? "Untitled" : entry.Title)</h3>

                        <div class="entry-mood">
                            <span class="mood-badge @GetMoodClass(entry)">@entry.PrimaryMood</span>
                            @if (!string.IsNullOrEmpty(entry.SecondaryMood1))
                            {
                                <span class="mood-badge secondary">@entry.SecondaryMood1</span>
                            }
                            @if (!string.IsNullOrEmpty(entry.SecondaryMood2))
                            {
                                <span class="mood-badge secondary">@entry.SecondaryMood2</span>
                            }
                        </div>

                        @if (entry.GetTags().Any())
                        {
                            <div class="entry-tags">
                                @foreach (var tag in entry.GetTags())
                                {
                                    <span class="tag">@tag</span>
                                }
                            </div>
                        }

                        <div class="entry-preview">@((MarkupString)GetPreview(entry.Content))</div>

                        <div class="entry-meta">
                            @entry.WordCount words • @entry.CreatedAt.ToString("g")
                        </div>
                    </div>
                </div>
            }

            <div class="pagination">
                <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(currentPage == 1)">◀ Previous</button>
                <span>Page @currentPage of @totalPages</span>
                <button class="btn btn-secondary" @onclick="NextPage" disabled="@(currentPage >= totalPages)">Next ▶</button>
            </div>
        }
        else
        {
            <div class="empty-state">
                <p>No entries found. Start writing your first journal entry!</p>
            </div>
        }
    </div>
</div>

@code {
    private List<JournalEntry> allEntries = new();
    private List<JournalEntry> filteredEntries = new();
    private List<JournalEntry> displayedEntries = new();
    private List<string> allTags = new();

    private bool showFilters = false;
    private string searchTerm = "";
    private DateTime? startDate;
    private DateTime? endDate;
    private string selectedMoodFilter = "";
    private string selectedTagFilter = "";

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        allEntries = await JournalService.GetAllEntriesAsync();
        allTags = allEntries
            .SelectMany(e => e.GetTags())
            .Distinct()
            .OrderBy(t => t)
            .ToList();

        filteredEntries = allEntries;
        UpdatePagination();
    }

    private void UpdatePagination()
    {
        totalPages = (int)Math.Ceiling(filteredEntries.Count / (double)pageSize);
        currentPage = Math.Max(1, Math.Min(currentPage, totalPages));

        displayedEntries = filteredEntries
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private async Task ApplyFilters()
    {
        filteredEntries = allEntries;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredEntries = await JournalService.SearchEntriesAsync(searchTerm);
        }

        var moods = string.IsNullOrWhiteSpace(selectedMoodFilter)
            ? null
            : new List<string> { selectedMoodFilter };

        var tags = string.IsNullOrWhiteSpace(selectedTagFilter)
            ? null
            : new List<string> { selectedTagFilter };

        filteredEntries = await JournalService.FilterEntriesAsync(
            startDate,
            endDate,
            moods,
            tags
        );

        currentPage = 1;
        UpdatePagination();
    }

    private async Task ClearFilters()
    {
        searchTerm = "";
        startDate = null;
        endDate = null;
        selectedMoodFilter = "";
        selectedTagFilter = "";

        await ApplyFilters();
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            UpdatePagination();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdatePagination();
        }
    }

    private string GetMoodClass(JournalEntry entry)
    {
        return entry.GetMoodCategory().ToString().ToLower();
    }

    private string GetPreview(string content)
    {
        var preview = System.Text.RegularExpressions.Regex.Replace(content, "<.*?>", string.Empty);
        return preview.Length > 200 ? preview.Substring(0, 200) + "..." : preview;
    }
}