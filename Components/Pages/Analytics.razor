@page "/analytics"
@inject AnalyticsService AnalyticsService
@inject ExportService ExportService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Analytics - My Journal</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
    return;
}

<div class="analytics-container">
    <div class="analytics-header">
        <h2>Journal Analytics</h2>
        <button class="btn btn-primary" @onclick="ShowExportModal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Export PDF
        </button>
    </div>

    <div class="date-filter">
        <div class="form-group">
            <label>Start Date</label>
            <input type="date" @bind="startDate" class="form-input" />
        </div>
        <div class="form-group">
            <label>End Date</label>
            <input type="date" @bind="endDate" class="form-input" />
        </div>
        <button class="btn btn-secondary" @onclick="LoadAnalytics">Update</button>
        <button class="btn btn-outline" @onclick="ShowAllTime">All Time</button>
    </div>

    @if (analytics != null)
    {
        <div class="stats-grid">
            <div class="stat-card streak">
                <div class="stat-content">
                    <div class="stat-label">Current Streak</div>
                    <div class="stat-value">@analytics.StreakInfo.CurrentStreak <span class="stat-unit">days</span></div>
                </div>
                <div class="stat-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                    </svg>
                </div>
            </div>

            <div class="stat-card trophy">
                <div class="stat-content">
                    <div class="stat-label">Longest Streak</div>
                    <div class="stat-value">@analytics.StreakInfo.LongestStreak <span class="stat-unit">days</span></div>
                </div>
                <div class="stat-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                        <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                        <path d="M4 22h16"></path>
                        <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                        <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                        <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
                    </svg>
                </div>
            </div>

            <div class="stat-card calendar">
                <div class="stat-content">
                    <div class="stat-label">Missed Days (30d)</div>
                    <div class="stat-value">@analytics.StreakInfo.MissedDays.Count <span class="stat-unit">days</span></div>
                </div>
                <div class="stat-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                </div>
            </div>

            <div class="stat-card mood">
                <div class="stat-content">
                    <div class="stat-label">Most Frequent Mood</div>
                    <div class="stat-value">@(analytics.MostFrequentMood ?? "N/A")</div>
                </div>
                <div class="stat-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
                        <line x1="9" y1="9" x2="9.01" y2="9"></line>
                        <line x1="15" y1="9" x2="15.01" y2="9"></line>
                    </svg>
                </div>
            </div>
        </div>

        <div class="charts-grid">
            <div class="chart-card">
                <h3>Mood Distribution</h3>
                <div class="mood-bars">
                    <div class="mood-bar-item">
                        <div class="mood-bar-label">Positive</div>
                        <div class="mood-bar-container">
                            <div class="mood-bar positive" style="width: @(analytics.MoodDistribution.PositivePercent)%"></div>
                        </div>
                        <div class="mood-bar-value">@analytics.MoodDistribution.PositiveCount (@analytics.MoodDistribution.PositivePercent.ToString("F1")%)</div>
                    </div>
                    <div class="mood-bar-item">
                        <div class="mood-bar-label">Neutral</div>
                        <div class="mood-bar-container">
                            <div class="mood-bar neutral" style="width: @(analytics.MoodDistribution.NeutralPercent)%"></div>
                        </div>
                        <div class="mood-bar-value">@analytics.MoodDistribution.NeutralCount (@analytics.MoodDistribution.NeutralPercent.ToString("F1")%)</div>
                    </div>
                    <div class="mood-bar-item">
                        <div class="mood-bar-label">Negative</div>
                        <div class="mood-bar-container">
                            <div class="mood-bar negative" style="width: @(analytics.MoodDistribution.NegativePercent)%"></div>
                        </div>
                        <div class="mood-bar-value">@analytics.MoodDistribution.NegativeCount (@analytics.MoodDistribution.NegativePercent.ToString("F1")%)</div>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <h3>Most Used Tags</h3>
                @if (analytics.MostUsedTags.Any())
                {
                    <div class="tags-chart">
                        @foreach (var tagUsage in analytics.MostUsedTags.Take(10))
                        {
                            <div class="tag-bar-item">
                                <div class="tag-label">@tagUsage.Tag</div>
                                <div class="tag-bar-container">
                                    <div class="tag-bar" style="width: @((tagUsage.Count * 100.0 / analytics.MostUsedTags.First().Count))%"></div>
                                </div>
                                <div class="tag-count">@tagUsage.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="empty-state">No tags used yet</p>
                }
            </div>
        </div>

        @if (analytics.WordCountTrends.Any())
        {
            <div class="chart-card full-width">
                <h3>Word Count Trends</h3>
                <div class="word-count-chart">
                    @foreach (var trend in analytics.WordCountTrends.OrderBy(t => t.Date))
                    {
                        var maxCount = analytics.WordCountTrends.Max(t => t.AverageWordCount);
                        var height = maxCount > 0 ? (trend.AverageWordCount / maxCount * 200) : 0;

                        <div class="word-count-bar-container">
                            <div class="word-count-bar" style="height: @(height)px;" title="@trend.AverageWordCount.ToString("F0") words">
                                <div class="word-count-value">@trend.AverageWordCount.ToString("F0")</div>
                            </div>
                            <div class="word-count-label">@trend.Date.ToString("MMM yy")</div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="@(isError ? "error-message" : "success-message")">@message</div>
    }
</div>

<!-- Export Modal -->
@if (showExportModal)
{
    <div class="modal-overlay" @onclick="CloseExportModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Export Journal Entries</h3>
                <button class="modal-close" @onclick="CloseExportModal">&times;</button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label>Start Date</label>
                    <input type="date" @bind="exportStartDate" class="form-input" />
                </div>

                <div class="form-group" style="margin-top:10px">
                    <label>End Date</label>
                    <input type="date" @bind="exportEndDate" class="form-input" />
                </div>

                <button class="btn btn-secondary" style="margin-top:20px" @onclick="LoadExportPreview" disabled="@isLoadingPreview">
                    @if (isLoadingPreview)
                    {
                        <span class="spinner"></span>
                    }
                    Load Preview
                </button>

                @if (showExportPreview)
                {
                    <div class="export-preview">
                        <h4>Preview (@previewEntries.Count entries)</h4>

                        @if (previewEntries.Any())
                        {
                            <div class="preview-list">
                                @foreach (var entry in previewEntries.Take(5))
                                {
                                    <div class="preview-entry">
                                        <div class="preview-date">@entry.Date.ToString("MMM d, yyyy")</div>
                                        <div class="preview-title">@(string.IsNullOrEmpty(entry.Title) ? "Untitled" : entry.Title)</div>
                                        <div class="preview-meta">
                                            <span class="badge">@entry.PrimaryMood</span>
                                            <span class="preview-words">@entry.WordCount words</span>
                                        </div>
                                    </div>
                                }
                                @if (previewEntries.Count > 5)
                                {
                                    <p class="text-muted">... and @(previewEntries.Count - 5) more entries</p>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No entries found in this date range.</p>
                        }
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline" @onclick="CloseExportModal">Cancel</button>
                <button class="btn btn-primary" @onclick="ExportPdf" disabled="@(!previewEntries.Any() || isExporting)">
                    @if (isExporting)
                    {
                        <span class="spinner"></span>
                    }
                    Export HTML/PDF
                </button>
            </div>
        </div>
    </div>
}



@code {
    private AnalyticsData? analytics;
    private DateTime? startDate;
    private DateTime? endDate;
    private string message = "";
    private bool isError = false;

    // Export modal state
    private bool showExportModal = false;
    private DateTime exportStartDate = DateTime.Today.AddDays(-30);
    private DateTime exportEndDate = DateTime.Today;
    private List<JournalEntry> previewEntries = new();
    private bool showExportPreview = false;
    private bool isLoadingPreview = false;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalytics();
    }

    private async Task LoadAnalytics()
    {
        analytics = await AnalyticsService.GetAnalyticsAsync(startDate, endDate);
    }

    private async Task ShowAllTime()
    {
        startDate = null;
        endDate = null;
        await LoadAnalytics();
    }

    private void ShowExportModal()
    {
        showExportModal = true;
        showExportPreview = false;
        previewEntries.Clear();

        // Set default export dates based on current analytics filter
        exportStartDate = startDate ?? DateTime.Today.AddDays(-30);
        exportEndDate = endDate ?? DateTime.Today;
    }

    private void CloseExportModal()
    {
        showExportModal = false;
        showExportPreview = false;
        previewEntries.Clear();
    }

    private async Task LoadExportPreview()
    {
        if (exportStartDate > exportEndDate)
        {
            await JS.InvokeVoidAsync("alert", "Start date must be before end date.");
            return;
        }

        isLoadingPreview = true;
        try
        {
            previewEntries = await ExportService.GetEntriesForExportAsync(exportStartDate, exportEndDate);
            showExportPreview = true;

            if (!previewEntries.Any())
            {
                await JS.InvokeVoidAsync("alert", "No entries found in this date range.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error loading preview: {ex.Message}");
        }
        finally
        {
            isLoadingPreview = false;
        }
    }

    private async Task ExportPdf()
    {
        if (!previewEntries.Any())
        {
            await JS.InvokeVoidAsync("alert", "No entries to export.");
            return;
        }

        isExporting = true;
        message = "";
        isError = false;

        try
        {
            var html = await ExportService.GenerateHtmlForDownloadAsync(exportStartDate, exportEndDate);
            var fileName = $"Journal_{exportStartDate:yyyy-MM-dd}_to_{exportEndDate:yyyy-MM-dd}.html";

            // Download the file
            await JS.InvokeVoidAsync("downloadFile", fileName, html);

            message = $"Export successful! File saved as {fileName}";
            CloseExportModal();

            await JS.InvokeVoidAsync("alert", "Export successful! The file has been downloaded. You can open it and print to PDF using your browser.");
        }
        catch (Exception ex)
        {
            message = $"Error exporting: {ex.Message}";
            isError = true;
            await JS.InvokeVoidAsync("alert", $"Error exporting: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }
}