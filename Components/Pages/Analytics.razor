@page "/analytics"

<PageTitle>Analytics</PageTitle>

<div class="analytics-page">
    <div class="analytics-header">
        <h1>Analytics & Insights</h1>
        <p>Understand your journaling patterns and emotional trends</p>
    </div>

    <div class="date-range-selector">
        <button class="range-btn active">Last 7 Days</button>
        <button class="range-btn">Last 30 Days</button>
        <button class="range-btn">Last 90 Days</button>
        <button class="range-btn">This Year</button>
        <button class="range-btn">All Time</button>
    </div>

    <div class="stats-overview">
        <div class="stat-card">
            <div class="stat-icon"></div>
            <div class="stat-info">
                <h3>Total Entries</h3>
                <p class="stat-value">42</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"></div>
            <div class="stat-info">
                <h3>Current Streak</h3>
                <p class="stat-value">7 days</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"></div>
            <div class="stat-info">
                <h3>Longest Streak</h3>
                <p class="stat-value">15 days</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon"></div>
            <div class="stat-info">
                <h3>Avg Words/Entry</h3>
                <p class="stat-value">287</p>
            </div>
        </div>
    </div>

    <div class="charts-grid">
        <!-- Mood Distribution -->
        <div class="chart-card full-width">
            <h2>Mood Distribution</h2>
            <div class="mood-distribution">
                <div class="pie-chart">
                    <svg viewBox="0 0 200 200" width="200" height="200">
                        <circle cx="100" cy="100" r="80" fill="#4ade80" stroke="white" stroke-width="2" />
                        <path d="M 100 100 L 100 20 A 80 80 0 0 1 180 100 Z" fill="#fbbf24" stroke="white" stroke-width="2" />
                        <path d="M 100 100 L 180 100 A 80 80 0 0 1 145 171 Z" fill="#f87171" stroke="white" stroke-width="2" />
                    </svg>
                    <div class="chart-center">
                        <span class="center-emoji"></span>
                    </div>
                </div>
                <div class="mood-legend">
                    <div class="legend-row">
                        <div class="legend-color positive"></div>
                        <span class="legend-label">Positive</span>
                        <span class="legend-value">60% (25 entries)</span>
                    </div>
                    <div class="legend-row">
                        <div class="legend-color neutral"></div>
                        <span class="legend-label">Neutral</span>
                        <span class="legend-value">25% (11 entries)</span>
                    </div>
                    <div class="legend-row">
                        <div class="legend-color negative"></div>
                        <span class="legend-label">Negative</span>
                        <span class="legend-value">15% (6 entries)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Most Frequent Moods -->
        <div class="chart-card">
            <h2>Most Frequent Moods</h2>
            <div class="mood-bars">
                <div class="mood-bar-item">
                    <div class="bar-header">
                        <span class="bar-mood">Happy</span>
                        <span class="bar-count">12</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill positive" style="width: 100%"></div>
                    </div>
                </div>
                <div class="mood-bar-item">
                    <div class="bar-header">
                        <span class="bar-mood">Relaxed</span>
                        <span class="bar-count">8</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill positive" style="width: 67%"></div>
                    </div>
                </div>
                <div class="mood-bar-item">
                    <div class="bar-header">
                        <span class="bar-mood">Thoughtful</span>
                        <span class="bar-count">6</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill neutral" style="width: 50%"></div>
                    </div>
                </div>
                <div class="mood-bar-item">
                    <div class="bar-header">
                        <span class="bar-mood">Grateful</span>
                        <span class="bar-count">5</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill positive" style="width: 42%"></div>
                    </div>
                </div>
                <div class="mood-bar-item">
                    <div class="bar-header">
                        <span class="bar-mood">Stressed</span>
                        <span class="bar-count">4</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill negative" style="width: 33%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Most Used Tags -->
        <div class="chart-card">
            <h2>Most Used Tags</h2>
            <div class="tag-chart">
                <div class="tag-bar-item">
                    <span class="tag-name">Work</span>
                    <div class="tag-bar-track">
                        <div class="tag-bar-fill" style="width: 85%"></div>
                    </div>
                    <span class="tag-count">18</span>
                </div>
                <div class="tag-bar-item">
                    <span class="tag-name">Personal Growth</span>
                    <div class="tag-bar-track">
                        <div class="tag-bar-fill" style="width: 70%"></div>
                    </div>
                    <span class="tag-count">15</span>
                </div>
                <div class="tag-bar-item">
                    <span class="tag-name">Health</span>
                    <div class="tag-bar-track">
                        <div class="tag-bar-fill" style="width: 60%"></div>
                    </div>
                    <span class="tag-count">13</span>
                </div>
                <div class="tag-bar-item">
                    <span class="tag-name">Exercise</span>
                    <div class="tag-bar-track">
                        <div class="tag-bar-fill" style="width: 50%"></div>
                    </div>
                    <span class="tag-count">11</span>
                </div>
                <div class="tag-bar-item">
                    <span class="tag-name">Reflection</span>
                    <div class="tag-bar-track">
                        <div class="tag-bar-fill" style="width: 45%"></div>
                    </div>
                    <span class="tag-count">10</span>
                </div>
                <div class="tag-bar-item">
                    <span class="tag-name">Family</span>
                    <div class="tag-bar-track">
                        <div class="tag-bar-fill" style="width: 40%"></div>
                    </div>
                    <span class="tag-count">9</span>
                </div>
            </div>
        </div>

        <!-- Tag Breakdown by Category -->
        <div class="chart-card">
            <h2>Tag Breakdown</h2>
            <div class="category-breakdown">
                <div class="category-item">
                    <div class="category-header">
                        <span class="category-icon"></span>
                        <span class="category-name">Work & Career</span>
                    </div>
                    <div class="category-bar">
                        <div class="category-fill" style="width: 35%"></div>
                    </div>
                    <span class="category-percent">35%</span>
                </div>
                <div class="category-item">
                    <div class="category-header">
                        <span class="category-icon"></span>
                        <span class="category-name">Health & Wellness</span>
                    </div>
                    <div class="category-bar">
                        <div class="category-fill" style="width: 28%"></div>
                    </div>
                    <span class="category-percent">28%</span>
                </div>
                <div class="category-item">
                    <div class="category-header">
                        <span class="category-icon"></span>
                        <span class="category-name">Personal Growth</span>
                    </div>
                    <div class="category-bar">
                        <div class="category-fill" style="width: 22%"></div>
                    </div>
                    <span class="category-percent">22%</span>
                </div>
                <div class="category-item">
                    <div class="category-header">
                        <span class="category-icon"></span>
                        <span class="category-name">Relationships</span>
                    </div>
                    <div class="category-bar">
                        <div class="category-fill" style="width: 15%"></div>
                    </div>
                    <span class="category-percent">15%</span>
                </div>
            </div>
        </div>

        <!-- Word Count Trends -->
        <div class="chart-card full-width">
            <h2>Word Count Trends</h2>
            <div class="line-chart">
                <div class="chart-y-axis">
                    <span>500</span>
                    <span>400</span>
                    <span>300</span>
                    <span>200</span>
                    <span>100</span>
                    <span>0</span>
                </div>
                <div class="chart-area">
                    <svg viewBox="0 0 600 200" class="line-svg">
                        <polyline points="0,100 60,80 120,120 180,60 240,90 300,70 360,110 420,85 480,95 540,75 600,90"
                                  fill="none"
                                  stroke="#5e3a8e"
                                  stroke-width="3" />
                        <circle cx="0" cy="100" r="4" fill="#5e3a8e" />
                        <circle cx="60" cy="80" r="4" fill="#5e3a8e" />
                        <circle cx="120" cy="120" r="4" fill="#5e3a8e" />
                        <circle cx="180" cy="60" r="4" fill="#5e3a8e" />
                        <circle cx="240" cy="90" r="4" fill="#5e3a8e" />
                        <circle cx="300" cy="70" r="4" fill="#5e3a8e" />
                        <circle cx="360" cy="110" r="4" fill="#5e3a8e" />
                        <circle cx="420" cy="85" r="4" fill="#5e3a8e" />
                        <circle cx="480" cy="95" r="4" fill="#5e3a8e" />
                        <circle cx="540" cy="75" r="4" fill="#5e3a8e" />
                        <circle cx="600" cy="90" r="4" fill="#5e3a8e" />
                    </svg>
                    <div class="chart-x-axis">
                        <span>Dec 9</span>
                        <span>Dec 11</span>
                        <span>Dec 13</span>
                        <span>Dec 15</span>
                        <span>Dec 17</span>
                        <span>Dec 19</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Streak Calendar -->
        <div class="chart-card full-width">
            <h2>Journaling Activity</h2>
            <div class="activity-grid">
                <div class="activity-months">
                    <span>Oct</span>
                    <span>Nov</span>
                    <span>Dec</span>
                </div>
                <div class="activity-cells">
                    <div class="activity-cell empty"></div>
                    <div class="activity-cell empty"></div>
                    <div class="activity-cell level-1"></div>
                    <div class="activity-cell level-2"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell level-2"></div>
                    <div class="activity-cell level-1"></div>
                    <div class="activity-cell empty"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell level-2"></div>
                    <div class="activity-cell level-1"></div>
                    <div class="activity-cell level-2"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell empty"></div>
                    <div class="activity-cell level-1"></div>
                    <div class="activity-cell level-2"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell level-2"></div>
                    <div class="activity-cell level-1"></div>
                    <div class="activity-cell level-2"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-3"></div>
                    <div class="activity-cell level-4"></div>
                    <div class="activity-cell level-4"></div>
                </div>
                <div class="activity-legend">
                    <span>Less</span>
                    <div class="legend-cell empty"></div>
                    <div class="legend-cell level-1"></div>
                    <div class="legend-cell level-2"></div>
                    <div class="legend-cell level-3"></div>
                    <div class="legend-cell level-4"></div>
                    <span>More</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .analytics-page {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    .analytics-header {
        margin-bottom: 2rem;
    }

        .analytics-header h1 {
            margin: 0 0 0.5rem 0;
            color: #333;
        }

        .analytics-header p {
            color: #666;
            font-size: 1.1rem;
        }

    .date-range-selector {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .range-btn {
        padding: 0.75rem 1.5rem;
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s;
    }

        .range-btn:hover {
            border-color: #5e3a8e;
        }

        .range-btn.active {
            background: #5e3a8e;
            color: white;
            border-color: #5e3a8e;
        }

    .stats-overview {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        font-size: 2.5rem;
    }

    .stat-info h3 {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
        color: #666;
        font-weight: 500;
    }

    .stat-value {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 700;
        color: #333;
    }

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 1.5rem;
    }

    .chart-card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .chart-card.full-width {
            grid-column: 1 / -1;
        }

        .chart-card h2 {
            margin: 0 0 1.5rem 0;
            color: #333;
            font-size: 1.3rem;
        }

    .mood-distribution {
        display: flex;
        gap: 3rem;
        align-items: center;
        justify-content: center;
    }

    .pie-chart {
        position: relative;
    }

    .chart-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .center-emoji {
        font-size: 3rem;
    }

    .mood-legend {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .legend-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .legend-color {
        width: 24px;
        height: 24px;
        border-radius: 4px;
    }

        .legend-color.positive {
            background: #4ade80;
        }

        .legend-color.neutral {
            background: #fbbf24;
        }

        .legend-color.negative {
            background: #f87171;
        }

    .legend-label {
        font-weight: 600;
        min-width: 80px;
    }

    .legend-value {
        color: #666;
    }

    .mood-bars {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .mood-bar-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .bar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .bar-mood {
        font-weight: 600;
        font-size: 1rem;
    }

    .bar-count {
        color: #666;
        font-weight: 600;
    }

    .bar-track {
        height: 12px;
        background: #f3f4f6;
        border-radius: 6px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        border-radius: 6px;
        transition: width 0.3s;
    }

        .bar-fill.positive {
            background: linear-gradient(90deg, #4ade80, #22c55e);
        }

        .bar-fill.neutral {
            background: linear-gradient(90deg, #fbbf24, #f59e0b);
        }

        .bar-fill.negative {
            background: linear-gradient(90deg, #f87171, #ef4444);
        }

    .tag-chart {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .tag-bar-item {
        display: grid;
        grid-template-columns: 150px 1fr 40px;
        align-items: center;
        gap: 1rem;
    }

    .tag-name {
        font-weight: 600;
        color: #333;
    }

    .tag-bar-track {
        height: 10px;
        background: #f3f4f6;
        border-radius: 5px;
        overflow: hidden;
    }

    .tag-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #5e3a8e, #7c3aed);
        border-radius: 5px;
    }

    .tag-count {
        color: #666;
        font-weight: 600;
        text-align: right;
    }

    .category-breakdown {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .category-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .category-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .category-icon {
        font-size: 1.5rem;
    }

    .category-name {
        font-weight: 600;
        color: #333;
    }

    .category-bar {
        height: 30px;
        background: #f3f4f6;
        border-radius: 8px;
        overflow: hidden;
        position: relative;
    }

    .category-fill {
        height: 100%;
        background: linear-gradient(90deg, #5e3a8e, #7c3aed);
        border-radius: 8px;
    }

    .category-percent {
        color: #666;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .line-chart {
        display: flex;
        gap: 1rem;
    }

    .chart-y-axis {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding-right: 0.5rem;
        color: #666;
        font-size: 0.85rem;
    }

    .chart-area {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .line-svg {
        width: 100%;
        height: 200px;
    }

    .chart-x-axis {
        display: flex;
        justify-content: space-between;
        margin-top: 0.5rem;
        color: #666;
        font-size: 0.85rem;
    }

    .activity-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .activity-months {
        display: flex;
        gap: 2rem;
        color: #666;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .activity-cells {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 0.5rem;
    }

    .activity-cell {
        aspect-ratio: 1;
        border-radius: 4px;
    }

        .activity-cell.empty {
            background: #f3f4f6;
        }

        .activity-cell.level-1 {
            background: #ddd6fe;
        }

        .activity-cell.level-2 {
            background: #c4b5fd;
        }

        .activity-cell.level-3 {
            background: #a78bfa;
        }

        .activity-cell.level-4 {
            background: #5e3a8e;
        }

    .activity-legend {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        justify-content: flex-end;
        color: #666;
        font-size: 0.85rem;
    }

    .legend-cell {
        width: 16px;
        height: 16px;
        border-radius: 3px;
    }

   
</style>