@page "/today"
@inject IJournalService JournalService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@using Journal.Models
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Today's Entry</PageTitle>

<div class="entry-page">
    <h1>Today's Journal Entry</h1>
    <p>@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</p>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="entry-form">

            <!-- TITLE -->
            <div class="form-group">
                <label>Title (Optional)</label>
                <input class="form-control" @bind="entry.Title" />
            </div>

            <!-- MOODS -->
            <h3>Mood Tracking</h3>

            <label>Primary Mood (Required)</label>
            <div class="mood-grid">
                @foreach (var mood in PrimaryMoods)
                {
                    <label>
                        <input type="radio"
                               name="primaryMood"
                               checked="@(entry.PrimaryMood == mood)"
                               @onchange="() => SetPrimaryMood(mood)" />
                        @mood
                    </label>
                }
            </div>

            <label>Secondary Moods (Max 2)</label>
            <div class="mood-grid">
                @foreach (var mood in SecondaryMoods)
                {
                    <label>
                        <input type="checkbox"
                               checked="@IsSecondarySelected(mood)"
                               @onchange="() => ToggleSecondaryMood(mood)" />
                        @mood
                    </label>
                }
            </div>

            <!-- CATEGORY -->
            <div class="form-group">
                <label>Category</label>
                <select class="form-control" @bind="entry.Category">
                    <option value="">-- Select --</option>
                    @foreach (var c in Categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>

            <!-- TAGS -->
            <div class="form-group">
                <label>Tags</label>
                <div class="selected-tags">
                    @foreach (var tag in selectedTags)
                    {
                        <span class="tag">
                            @tag <button @onclick="() => RemoveTag(tag)">×</button>
                        </span>
                    }
                </div>

                <input class="form-control"
                       placeholder="Add custom tag and press Enter"
                       @bind="newTag"
                       @onkeydown="OnTagKeyDown" />

                <div class="preset-tags">
                    @foreach (var tag in PresetTags)
                    {
                        <button class="tag-btn" @onclick="() => AddTag(tag)">
                            @tag
                        </button>
                    }
                </div>
            </div>

            <!-- QUILL EDITOR -->
            <div class="editor-section">
                <label>Journal Content</label>
                <div id="quillEditor" class="quill-editor" @key="entry.EntryDate"></div>
                <small>@WordCount words</small>
            </div>

            <!-- ACTIONS -->
            <div class="actions">
                <button @onclick="SaveEntry" disabled="@isSaving">Save</button>

                @if (entry.Id > 0)
                {
                    <button @onclick="DeleteEntry">Delete</button>
                }
            </div>
        </div>
    }
</div>

<style>
    .quill-editor {
        height: 400px;
        background: white;
    }

    .mood-grid label {
        margin-right: 10px;
    }

    .tag {
        margin-right: 5px;
        background: #eee;
        padding: 4px;
    }

    .tag-btn {
        margin: 2px;
    }
</style>

@code {
    private JournalEntry entry = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool quillReady;

    private List<string> selectedTags = new();
    private string newTag = "";

    private readonly string[] PrimaryMoods =
    {
        "Happy","Excited","Relaxed","Grateful","Confident",
        "Calm","Thoughtful","Curious","Nostalgic","Bored",
        "Sad","Angry","Stressed","Lonely","Anxious"
    };

    private readonly string[] SecondaryMoods =
    {
        "Happy","Stressed","Relaxed","Anxious","Excited"
    };

    private readonly string[] Categories =
    {
        "Work","Career","Studies","Family","Friends","Health","Fitness",
        "Personal Growth","Self-care","Hobbies","Travel","Finance","Spirituality"
    };

    private readonly string[] PresetTags =
    {
        "Exercise","Reading","Writing","Meditation","Music","Planning","Reflection"
    };

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;

        entry = await JournalService.GetEntryByDateAsync(today)
            ?? new JournalEntry { EntryDate = today };

        selectedTags = string.IsNullOrWhiteSpace(entry.Tags)
            ? new()
            : entry.Tags.Split(',').ToList();

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!quillReady && !isLoading)
        {
            await JSRuntime.InvokeVoidAsync("initQuill", entry.Content);
            quillReady = true;
        }
    }

    private void SetPrimaryMood(string mood)
    {
        entry.PrimaryMood = mood;
        entry.MoodCategory =
            PositiveMoods.Contains(mood) ? "Positive" :
            NegativeMoods.Contains(mood) ? "Negative" :
            "Neutral";
    }

    private static readonly HashSet<string> PositiveMoods =
        new() { "Happy", "Excited", "Relaxed", "Grateful", "Confident" };

    private static readonly HashSet<string> NegativeMoods =
        new() { "Sad", "Angry", "Stressed", "Lonely", "Anxious" };

    private void ToggleSecondaryMood(string mood)
    {
        var list = (entry.SecondaryMoods ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .ToList();

        if (list.Contains(mood)) list.Remove(mood);
        else if (list.Count < 2) list.Add(mood);

        entry.SecondaryMoods = string.Join(",", list);
    }

    private bool IsSecondarySelected(string mood) =>
        entry.SecondaryMoods?.Split(',').Contains(mood) == true;

    private void AddTag(string tag)
    {
        if (!selectedTags.Contains(tag))
        {
            selectedTags.Add(tag);
            entry.Tags = string.Join(",", selectedTags);
        }
    }

    private void RemoveTag(string tag)
    {
        selectedTags.Remove(tag);
        entry.Tags = string.Join(",", selectedTags);
    }

    private void OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newTag))
        {
            AddTag(newTag.Trim());
            newTag = "";
        }
    }

    private int WordCount =>
        string.IsNullOrWhiteSpace(entry.Content)
            ? 0
            : System.Text.RegularExpressions.Regex.Matches(entry.Content, @"\b\w+\b").Count;

    private async Task SaveEntry()
    {
        entry.Content = await JSRuntime.InvokeAsync<string>("getQuillContent");
        entry.UpdatedAt = DateTime.UtcNow;

        await JournalService.SaveEntryAsync(entry);
        Navigation.NavigateTo("/");
    }

    private async Task DeleteEntry()
    {
        await JournalService.DeleteEntryAsync(entry.Id);
        Navigation.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        if (quillReady)
            await JSRuntime.InvokeVoidAsync("destroyQuill");
    }
}
