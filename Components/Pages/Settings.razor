@page "/settings"

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    <div class="settings-header">
        <h1>⚙️ Settings</h1>
        <p>Customize your journaling experience</p>
    </div>

    <div class="settings-container">
        <!-- Security Section -->
        <div class="settings-section">
            <h2>🔒 Security & Privacy</h2>
            <div class="setting-item">
                <div class="setting-info">
                    <h3>Password Protection</h3>
                    <p>Protect your journal with a password</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Change Password</h3>
                    <p>Update your journal password</p>
                </div>
                <button class="btn-action">Change</button>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>PIN Lock</h3>
                    <p>Quick access with a 4-digit PIN</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Auto-Lock</h3>
                    <p>Lock journal after inactivity</p>
                </div>
                <select class="setting-select">
                    <option>5 minutes</option>
                    <option>10 minutes</option>
                    <option>30 minutes</option>
                    <option>Never</option>
                </select>
            </div>
        </div>

        <!-- Appearance Section -->
        <div class="settings-section">
            <h2>🎨 Appearance</h2>
            <div class="setting-item">
                <div class="setting-info">
                    <h3>Theme</h3>
                    <p>Choose your preferred color scheme</p>
                </div>
                <div class="theme-selector">
                    <button class="theme-option active">
                        <div class="theme-preview light">
                            <div class="preview-bar"></div>
                            <div class="preview-content"></div>
                        </div>
                        <span>Light</span>
                    </button>
                    <button class="theme-option">
                        <div class="theme-preview dark">
                            <div class="preview-bar"></div>
                            <div class="preview-content"></div>
                        </div>
                        <span>Dark</span>
                    </button>
                    <button class="theme-option">
                        <div class="theme-preview auto">
                            <div class="preview-bar"></div>
                            <div class="preview-content"></div>
                        </div>
                        <span>Auto</span>
                    </button>
                </div>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Accent Color</h3>
                    <p>Customize the app's accent color</p>
                </div>
                <div class="color-picker">
                    <button class="color-option active" style="background: #5e3a8e"></button>
                    <button class="color-option" style="background: #3b82f6"></button>
                    <button class="color-option" style="background: #10b981"></button>
                    <button class="color-option" style="background: #f59e0b"></button>
                    <button class="color-option" style="background: #ef4444"></button>
                    <button class="color-option" style="background: #8b5cf6"></button>
                </div>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Font Size</h3>
                    <p>Adjust text size for better readability</p>
                </div>
                <select class="setting-select">
                    <option>Small</option>
                    <option selected>Medium</option>
                    <option>Large</option>
                    <option>Extra Large</option>
                </select>
            </div>
        </div>

        <!-- Editor Preferences -->
        <div class="settings-section">
            <h2>✍️ Editor Preferences</h2>
            <div class="setting-item">
                <div class="setting-info">
                    <h3>Default Format</h3>
                    <p>Choose your preferred writing format</p>
                </div>
                <div class="radio-group">
                    <label class="radio-option">
                        <input type="radio" name="format" checked />
                        <span>Rich Text</span>
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="format" />
                        <span>Markdown</span>
                    </label>
                </div>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Auto-Save</h3>
                    <p>Automatically save changes as you type</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Spell Check</h3>
                    <p>Enable spell checking while writing</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Word Count</h3>
                    <p>Show word count while writing</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked />
                    <span class="slider"></span>
                </label>
            </div>
        </div>

        <!-- Reminders & Notifications -->
        <div class="settings-section">
            <h2>🔔 Reminders</h2>
            <div class="setting-item">
                <div class="setting-info">
                    <h3>Daily Reminder</h3>
                    <p>Get reminded to journal every day</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Reminder Time</h3>
                    <p>When should we remind you?</p>
                </div>
                <input type="time" class="setting-input" value="20:00" />
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Streak Alerts</h3>
                    <p>Get notified about streak milestones</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" checked />
                    <span class="slider"></span>
                </label>
            </div>
        </div>

        <!-- Data Management -->
        <div class="settings-section">
            <h2>💾 Data Management</h2>
            <div class="setting-item">
                <div class="setting-info">
                    <h3>Export All Entries</h3>
                    <p>Download all your journal entries as PDF</p>
                </div>
                <button class="btn-action">📥 Export</button>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Export Date Range</h3>
                    <p>Export entries from a specific period</p>
                </div>
                <button class="btn-action">📥 Export Range</button>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Backup Data</h3>
                    <p>Create a backup of your journal database</p>
                </div>
                <button class="btn-action">💾 Backup</button>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Import Data</h3>
                    <p>Restore from a previous backup</p>
                </div>
                <button class="btn-action">📤 Import</button>
            </div>

            <div class="setting-item danger">
                <div class="setting-info">
                    <h3>Clear All Data</h3>
                    <p>Permanently delete all journal entries</p>
                </div>
                <button class="btn-danger">🗑️ Clear All</button>
            </div>
        </div>

        <!-- About -->
        <div class="settings-section">
            <h2>ℹ️ About</h2>
            <div class="about-info">
                <div class="about-row">
                    <span class="about-label">Version</span>
                    <span class="about-value">1.0.0</span>
                </div>
                <div class="about-row">
                    <span class="about-label">Database Location</span>
                    <span class="about-value">C:\Users\YourName\AppData\Local\MyJournal\journal.db</span>
                </div>
                <div class="about-row">
                    <span class="about-label">Total Entries</span>
                    <span class="about-value">42 entries</span>
                </div>
                <div class="about-row">
                    <span class="about-label">Storage Used</span>
                    <span class="about-value">2.4 MB</span>
                </div>
            </div>

            <div class="about-links">
                <button class="link-btn">📖 User Guide</button>
                <button class="link-btn">💬 Send Feedback</button>
                <button class="link-btn">⭐ Rate This App</button>
            </div>
        </div>
    </div>
</div>

<style>
    .settings-page {
        padding: 2rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .settings-header {
        margin-bottom: 2rem;
    }

        .settings-header h1 {
            margin: 0 0 0.5rem 0;
            color: #333;
        }

        .settings-header p {
            color: #666;
            font-size: 1.1rem;
        }

    .settings-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .settings-section {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .settings-section h2 {
            margin: 0 0 1.5rem 0;
            color: #333;
            font-size: 1.3rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f3f4f6;
        }

    .setting-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 0;
        border-bottom: 1px solid #f3f4f6;
    }

        .setting-item:last-child {
            border-bottom: none;
        }

        .setting-item.danger {
            background: #fef2f2;
            padding: 1.25rem;
            border-radius: 8px;
            border: 1px solid #fecaca;
        }

    .setting-info {
        flex: 1;
    }

        .setting-info h3 {
            margin: 0 0 0.25rem 0;
            color: #333;
            font-size: 1rem;
            font-weight: 600;
        }

        .setting-info p {
            margin: 0;
            color: #666;
            font-size: 0.9rem;
        }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 52px;
        height: 28px;
    }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #cbd5e1;
        transition: 0.3s;
        border-radius: 28px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: 0.3s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #5e3a8e;
    }

        input:checked + .slider:before {
            transform: translateX(24px);
        }

    .btn-action {
        padding: 0.5rem 1.25rem;
        background: #5e3a8e;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-action:hover {
            background: #4a2c6d;
        }

    .btn-danger {
        padding: 0.5rem 1.25rem;
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-danger:hover {
            background: #b91c1c;
        }

    .setting-select {
        padding: 0.5rem 1rem;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        background: white;
        cursor: pointer;
        font-size: 0.95rem;
    }

    .setting-input {
        padding: 0.5rem 1rem;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 0.95rem;
    }

    .theme-selector {
        display: flex;
        gap: 1rem;
    }

    .theme-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem;
        background: white;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .theme-option:hover {
            border-color: #5e3a8e;
        }

        .theme-option.active {
            border-color: #5e3a8e;
            background: #f5f3ff;
        }

    .theme-preview {
        width: 60px;
        height: 40px;
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        .theme-preview.light {
            background: white;
            border: 1px solid #e5e7eb;
        }

        .theme-preview.dark {
            background: #1f2937;
        }

        .theme-preview.auto {
            background: linear-gradient(90deg, white 50%, #1f2937 50%);
        }

    .preview-bar {
        height: 8px;
        background: #5e3a8e;
    }

    .preview-content {
        flex: 1;
    }

    .color-picker {
        display: flex;
        gap: 0.75rem;
    }

    .color-option {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        border: 3px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

        .color-option:hover {
            transform: scale(1.1);
        }

        .color-option.active {
            border-color: #333;
            box-shadow: 0 0 0 2px white, 0 0 0 4px currentColor;
        }

    .radio-group {
        display: flex;
        gap: 1rem;
    }

    .radio-option {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: #f9fafb;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .radio-option:has(input:checked) {
            background: #f5f3ff;
            border-color: #5e3a8e;
        }

        .radio-option input[type="radio"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

    .about-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .about-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem;
        background: #f9fafb;
        border-radius: 6px;
    }

    .about-label {
        font-weight: 600;
        color: #555;
    }

    .about-value {
        color: #666;
        text-align: right;
    }

    .about-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .link-btn {
        padding: 0.75rem 1.5rem;
        background: #f3f4f6;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .link-btn:hover {
            background: #e5e7eb;
        }

   
</style>

