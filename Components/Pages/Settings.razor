@page "/settings"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ThemeService ThemeService

<PageTitle>Settings - My Journal</PageTitle>

@* Redirect if not authenticated *@
@if (!AuthService.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
    return;
}

<div class="settings-container">
    <h2>Settings</h2>

    <!-- Theme Section -->
    <div class="settings-section">
        <h3>Theme Customization</h3>
        <p class="section-description">Personalize your journal's appearance</p>

        <div class="theme-options">
            <div class="form-group">
                <label for="themeSelect">Theme Mode:</label>
                <select id="themeSelect" @bind="selectedTheme" class="form-select">
                    <option value="light">☀️ Light</option>
                    <option value="dark">🌙 Dark</option>
                    <option value="auto">🔄 Auto (System)</option>
                    <option value="custom">🎨 Custom</option>
                </select>
            </div>

            @if (selectedTheme == "custom")
            {
                <div class="custom-theme-editor">
                    <h4>Custom Theme Colors</h4>

                    <div class="color-picker-group">
                        <div class="form-group">
                            <label>Primary Color:</label>
                            <input type="color" @bind="customPrimaryColor" class="color-input" />
                            <span class="color-value">@customPrimaryColor</span>
                        </div>

                        <div class="form-group">
                            <label>Background Color:</label>
                            <input type="color" @bind="customBackgroundColor" class="color-input" />
                            <span class="color-value">@customBackgroundColor</span>
                        </div>

                        <div class="form-group">
                            <label>Text Color:</label>
                            <input type="color" @bind="customTextColor" class="color-input" />
                            <span class="color-value">@customTextColor</span>
                        </div>

                        <div class="form-group">
                            <label>Card Background:</label>
                            <input type="color" @bind="customCardBackground" class="color-input" />
                            <span class="color-value">@customCardBackground</span>
                        </div>
                    </div>

                    <button class="btn btn-primary" @onclick="ApplyCustomTheme">Apply Custom Theme</button>
                    <button class="btn btn-outline" @onclick="ResetCustomTheme">Reset to Default</button>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(themeMessage))
        {
            <div class="success-message">@themeMessage</div>
        }
    </div>

    <!-- Account Section -->
    <div class="settings-section">
        <h3>Account</h3>
        <button class="btn btn-danger" @onclick="Logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Logout
        </button>
    </div>

    <!-- Application Section -->
    <div class="settings-section">
        <h3>Application</h3>
        <button class="btn btn-outline" @onclick="QuitApp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
                <line x1="12" y1="2" x2="12" y2="12"></line>
            </svg>
            Quit App
        </button>
    </div>
</div>

@code {
    private string selectedTheme = "light";
    private string customPrimaryColor = "#6366f1";
    private string customBackgroundColor = "#ffffff";
    private string customTextColor = "#1f2937";
    private string customCardBackground = "#f9fafb";
    private string themeMessage = "";

    protected override async Task OnInitializedAsync()
    {
        selectedTheme = await ThemeService.GetCurrentThemeAsync();

        if (selectedTheme == "custom")
        {
            var customColors = await ThemeService.GetCustomColorsAsync();
            if (customColors != null)
            {
                customPrimaryColor = customColors.PrimaryColor;
                customBackgroundColor = customColors.BackgroundColor;
                customTextColor = customColors.TextColor;
                customCardBackground = customColors.CardBackground;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyTheme();
        }
    }

    private async Task ApplyTheme()
    {
        if (selectedTheme == "custom")
        {
            await ThemeService.ApplyCustomThemeAsync(
                customPrimaryColor,
                customBackgroundColor,
                customTextColor,
                customCardBackground
            );
        }
        else
        {
            await ThemeService.SetThemeAsync(selectedTheme);
        }

        themeMessage = "Theme applied successfully!";
        StateHasChanged();

        await Task.Delay(2000);
        themeMessage = "";
        StateHasChanged();
    }

    private async Task ApplyCustomTheme()
    {
        await ApplyTheme();
    }

    private async Task ResetCustomTheme()
    {
        customPrimaryColor = "#6366f1";
        customBackgroundColor = "#ffffff";
        customTextColor = "#1f2937";
        customCardBackground = "#f9fafb";
        await ApplyCustomTheme();
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }

    private async Task QuitApp()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to quit the application?");
        if (confirmed)
        {
            await JS.InvokeVoidAsync("close");
        }
    }
}