@page "/settings"
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ThemeService ThemeService

<PageTitle>Settings - My Journal</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    Navigation.NavigateTo("/login");
    return;
}

<div class="settings-container">
    <div class="settings-header">
        <h2>Settings</h2>
        <p class="settings-subtitle">Customize your journal experience</p>
    </div>

    <!-- Theme Section -->
    <div class="settings-section theme-section">
        <div class="section-header">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <div>
                <h3>Theme & Appearance</h3>
                <p class="section-description">Personalize how your journal looks</p>
            </div>
        </div>

        <div class="theme-selector">
            <div class="theme-option @(selectedTheme == "light" ? "active" : "")" @onclick='() => SelectTheme("light")'>
                <div class="theme-icon-svg">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                </div>
                <div class="theme-info">
                    <h4>Light</h4>
                    <p>Bright and clean</p>
                </div>
                @if (selectedTheme == "light")
                {
                    <div class="check-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                }
            </div>

            <div class="theme-option @(selectedTheme == "dark" ? "active" : "")" @onclick='() => SelectTheme("dark")'>
                <div class="theme-icon-svg">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </div>
                <div class="theme-info">
                    <h4>Dark</h4>
                    <p>Easy on the eyes</p>
                </div>
                @if (selectedTheme == "dark")
                {
                    <div class="check-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                }
            </div>

            <div class="theme-option @(selectedTheme == "auto" ? "active" : "")" @onclick='() => SelectTheme("auto")'>
                <div class="theme-icon-svg">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 2a10 10 0 0 0 0 20V2z" fill="currentColor" opacity="0.3"></path>
                    </svg>
                </div>
                <div class="theme-info">
                    <h4>Auto</h4>
                    <p>Follows system</p>
                </div>
                @if (selectedTheme == "auto")
                {
                    <div class="check-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                }
            </div>

            <div class="theme-option @(selectedTheme == "custom" ? "active" : "")" @onclick='() => SelectTheme("custom")'>
                <div class="theme-icon-svg">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
                        <circle cx="12" cy="12" r="2"></circle>
                    </svg>
                </div>
                <div class="theme-info">
                    <h4>Custom</h4>
                    <p>Make it yours</p>
                </div>
                @if (selectedTheme == "custom")
                {
                    <div class="check-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                }
            </div>
        </div>

        @if (selectedTheme == "custom")
        {
            <div class="custom-theme-editor">
                <h4>Custom Theme Colors</h4>

                <div class="color-picker-grid">
                    <div class="color-picker-item">
                        <label>Primary Color</label>
                        <div class="color-input-wrapper">
                            <input type="color" @bind="customPrimaryColor" @bind:event="oninput" class="color-input" />
                            <span class="color-value">@customPrimaryColor</span>
                        </div>
                        <div class="color-preview" style="background-color: @customPrimaryColor;"></div>
                    </div>

                    <div class="color-picker-item">
                        <label>Background</label>
                        <div class="color-input-wrapper">
                            <input type="color" @bind="customBackgroundColor" @bind:event="oninput" class="color-input" />
                            <span class="color-value">@customBackgroundColor</span>
                        </div>
                        <div class="color-preview" style="background-color: @customBackgroundColor;"></div>
                    </div>

                    <div class="color-picker-item">
                        <label>Text Color</label>
                        <div class="color-input-wrapper">
                            <input type="color" @bind="customTextColor" @bind:event="oninput" class="color-input" />
                            <span class="color-value">@customTextColor</span>
                        </div>
                        <div class="color-preview" style="background-color: @customTextColor;"></div>
                    </div>

                    <div class="color-picker-item">
                        <label>Card Background</label>
                        <div class="color-input-wrapper">
                            <input type="color" @bind="customCardBackground" @bind:event="oninput" class="color-input" />
                            <span class="color-value">@customCardBackground</span>
                        </div>
                        <div class="color-preview" style="background-color: @customCardBackground;"></div>
                    </div>
                </div>

                <div class="custom-theme-actions">
                    <button class="btn btn-primary" @onclick="ApplyCustomTheme">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Apply Theme
                    </button>
                    <button class="btn btn-secondary" @onclick="ResetCustomTheme">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
                        </svg>
                        Reset to Default
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(themeMessage))
        {
            <div class="message-box success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                @themeMessage
            </div>
        }
    </div>

    <!-- Account Section -->
    <div class="settings-section">
        <div class="section-header">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <div>
                <h3>Account</h3>
                <p class="section-description">Manage your account settings</p>
            </div>
        </div>

        <button class="btn btn-danger" @onclick="Logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Logout
        </button>
    </div>
</div>

@code {
    private string selectedTheme = "light";
    private string customPrimaryColor = "#4A90E2";
    private string customBackgroundColor = "#ffffff";
    private string customTextColor = "#333333";
    private string customCardBackground = "#f9fafb";
    private string themeMessage = "";

    protected override async Task OnInitializedAsync()
    {
        selectedTheme = await ThemeService.GetCurrentThemeAsync();

        if (selectedTheme == "custom")
        {
            var customColors = await ThemeService.GetCustomColorsAsync();
            if (customColors != null)
            {
                customPrimaryColor = customColors.PrimaryColor;
                customBackgroundColor = customColors.BackgroundColor;
                customTextColor = customColors.TextColor;
                customCardBackground = customColors.CardBackground;
            }
        }
    }

    private async Task SelectTheme(string theme)
    {
        selectedTheme = theme;

        if (theme != "custom")
        {
            await ThemeService.SetThemeAsync(theme);
            ShowMessage("Theme applied successfully!");
        }
    }

    private async Task ApplyCustomTheme()
    {
        await ThemeService.ApplyCustomThemeAsync(
            customPrimaryColor,
            customBackgroundColor,
            customTextColor,
            customCardBackground
        );

        ShowMessage("Custom theme applied successfully!");
    }

    private async Task ResetCustomTheme()
    {
        customPrimaryColor = "#4A90E2";
        customBackgroundColor = "#ffffff";
        customTextColor = "#333333";
        customCardBackground = "#f9fafb";

        await ApplyCustomTheme();
        ShowMessage("Theme reset to defaults!");
    }

    private async void ShowMessage(string message)
    {
        themeMessage = message;
        StateHasChanged();

        await Task.Delay(3000);
        themeMessage = "";
        StateHasChanged();
    }

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}