@page "/settings"
@inject IJSRuntime JS

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    <div class="settings-header">
        <h1>⚙️ Settings</h1>
        <p>Customize your journaling experience</p>
    </div>

    <div class="settings-container">

        <!-- Appearance Section -->
        <div class="settings-section">
            <h2>🎨 Appearance</h2>

            <!-- Theme Selector -->
            <div class="setting-item">
                <div class="setting-info">
                    <h3>Theme</h3>
                    <p>Choose your preferred color scheme</p>
                </div>
                <div class="theme-selector">
                    @foreach (var theme in themes)
                    {
                        <button class="theme-option @(selectedTheme == theme ? "active" : "")" @onclick="() => SelectTheme(theme)">
                            <div class="theme-preview @(theme)">
                                <div class="preview-bar"></div>
                                <div class="preview-content"></div>
                            </div>
                            <span>@theme</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Accent Color -->
            <div class="setting-item">
                <div class="setting-info">
                    <h3>Accent Color</h3>
                    <p>Customize the app's accent color</p>
                </div>
                <div class="color-picker">
                    @foreach (var color in accentColors)
                    {
                        <button class="color-option @(selectedAccent == color ? "active" : "")"
                                style="background:@color" @onclick="() => SelectAccent(color)">
                        </button>
                    }
                </div>
            </div>

            <!-- Font Size -->
            <div class="setting-item">
                <div class="setting-info">
                    <h3>Font Size</h3>
                    <p>Adjust text size for better readability</p>
                </div>
                <select class="setting-select" @bind="selectedFontSize">
                    @foreach (var size in fontSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>

            </div>
        </div>

        <!-- Editor Preferences -->
        <div class="settings-section">
            <h2>✍️ Editor Preferences</h2>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Auto-Save</h3>
                    <p>Automatically save changes as you type</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="autoSave" />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Spell Check</h3>
                    <p>Enable spell checking while writing</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="spellCheck" />
                    <span class="slider"></span>
                </label>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Word Count</h3>
                    <p>Show word count while writing</p>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="showWordCount" />
                    <span class="slider"></span>
                </label>
            </div>
        </div>

        <!-- Data Management -->
        <div class="settings-section">
            <h2>💾 Data Management</h2>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Export All Entries</h3>
                    <p>Download all your journal entries as PDF</p>
                </div>
                <button class="btn-action" @onclick="ExportAll">📥 Export</button>
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Backup Data</h3>
                    <p>Create a backup of your journal database</p>
                </div>
                <button class="btn-action" @onclick="BackupData">💾 Backup</button>
            </div>

            <div class="setting-item danger">
                <div class="setting-info">
                    <h3>Clear All Data</h3>
                    <p>Permanently delete all journal entries</p>
                </div>
                <button class="btn-danger" @onclick="ClearAllData">🗑️ Clear All</button>
            </div>
        </div>
    </div>
</div>

@code {
    // Appearance options
    private string selectedTheme;
    private string selectedAccent;
    private string selectedFontSize
    {
        get => _selectedFontSize;
        set
        {
            if (_selectedFontSize != value)
            {
                _selectedFontSize = value;
                _ = JS.InvokeVoidAsync("setFontSize", _selectedFontSize);
            }
        }
    }
    private string _selectedFontSize = "Medium";


    private string[] themes = new[] { "light", "dark", "auto" };
    private string[] accentColors = new[] { "#5e3a8e", "#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6" };
    private string[] fontSizes = new[] { "Small", "Medium", "Large", "Extra Large" };

    // Editor toggles
    private bool autoSave = true;
    private bool spellCheck = true;
    private bool showWordCount = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load saved settings from JS
            var settings = await JS.InvokeAsync<SettingsModel>("eval", "window.initialSettings");
            selectedTheme = settings.theme;
            selectedAccent = settings.accent;
            selectedFontSize = settings.fontSize;

            // Apply them in JS to be sure
            await JS.InvokeVoidAsync("applyTheme", selectedTheme);
            await JS.InvokeVoidAsync("setAccentColor", selectedAccent);
            await JS.InvokeVoidAsync("setFontSize", selectedFontSize);

            StateHasChanged();
        }
    }

    private async Task SelectTheme(string theme)
    {
        selectedTheme = theme;
        await JS.InvokeVoidAsync("applyTheme", theme);
    }

    private async Task SelectAccent(string color)
    {
        selectedAccent = color;
        await JS.InvokeVoidAsync("setAccentColor", color);
    }

    private async Task UpdateFontSize(ChangeEventArgs e)
    {
        selectedFontSize = e.Value?.ToString() ?? "Medium";
        await JS.InvokeVoidAsync("setFontSize", selectedFontSize);
    }

    // Data Management placeholders
    private void ExportAll() => Console.WriteLine("Export all entries triggered");
    private void BackupData() => Console.WriteLine("Backup data triggered");

    private async Task ClearAllData()
    {
        if (await confirm("Are you sure you want to delete all entries?"))
        {
            Console.WriteLine("Clearing all data...");
        }
    }

    private async Task<bool> confirm(string message)
        => await JS.InvokeAsync<bool>("confirm", message);

    private class SettingsModel
    {
        public string theme { get; set; }
        public string accent { get; set; }
        public string fontSize { get; set; }
    }
}
