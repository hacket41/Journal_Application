@page "/"
@using System.Globalization

<PageTitle>Dashboard</PageTitle>

<div class="dashboard">
    <div class="dashboard-header">
        <h1>Welcome Back!</h1>
        <p class="date-display">@DateTime.Now.ToString("dddd, MMMM dd, yyyy", CultureInfo.InvariantCulture)</p>
    </div>

    <div class="stats-grid">
        <StatCard Icon="🔥" Title="Current Streak" Value="7 days" />
        <StatCard Icon="🏆" Title="Longest Streak" Value="15 days" />
        <StatCard Icon="📝" Title="Total Entries" Value="42" />
        <StatCard Icon="📅" Title="Missed Days" Value="3 days" />
    </div>

    <div class="content-grid">
        <div class="card mood-card">
            <h2>Mood Overview (Last 7 Days)</h2>
            <div class="mood-chart">
                <div class="mood-bar positive" style="width: 60%">
                    <span>Positive <strong>60%</strong></span>
                </div>
                <div class="mood-bar neutral" style="width: 25%">
                    <span>Neutral <strong>25%</strong></span>
                </div>
                <div class="mood-bar negative" style="width: 15%">
                    <span>Negative <strong>15%</strong></span>
                </div>
            </div>
        </div>

        <div class="card frequent-mood">
            <h2>Most Frequent Moods</h2>
            <div class="mood-list">
                <MoodItem Emoji="😊" Name="Happy" Count="12" />
                <MoodItem Emoji="😌" Name="Calm" Count="8" />
                <MoodItem Emoji="🤔" Name="Thoughtful" Count="6" />
            </div>
        </div>

        <div class="card tags-card">
            <h2>Most Used Tags</h2>
            <div class="tag-cloud">
                <TagItem Text="Work" Size="lg" />
                <TagItem Text="Health" Size="md" />
                <TagItem Text="Personal Growth" Size="lg" />
                <TagItem Text="Travel" Size="sm" />
                <TagItem Text="Exercise" Size="md" />
                <TagItem Text="Reading" Size="sm" />
                <TagItem Text="Family" Size="md" />
            </div>
        </div>

        <div class="card quick-action">
            <h2>Quick Actions</h2>
            <div class="action-buttons">
                <a href="/today" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2zm1 2a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2zm2 2v10h8V4H5z"/>
                    </svg>
                    Write Today’s Entry
                </a>
                <a href="/timeline" class="btn btn-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM2 2a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H2z"/>
                        <path d="M2 3.5v-.5H1v.5a.5.5 0 0 1-.5.5H0v1h.5a.5.5 0 0 1 .5.5v.5h1v-.5a.5.5 0 0 1 .5-.5H3v-1H2.5a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                    View Timeline
                </a>
                <a href="/calendar" class="btn btn-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                    </svg>
                    Open Calendar
                </a>
            </div>
        </div>
    </div>
</div>


@code {
    private class StatCard : ComponentBase
    {
        [Parameter] public string Icon { get; set; } = "•";
        [Parameter] public string Title { get; set; } = "";
        [Parameter] public string Value { get; set; } = "";

        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "stat-card");
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "stat-icon");
            builder.AddContent(4, Icon);
            builder.CloseElement();
            builder.OpenElement(5, "div");
            builder.AddAttribute(6, "class", "stat-content");
            builder.OpenElement(7, "h3");
            builder.AddContent(8, Title);
            builder.CloseElement();
            builder.OpenElement(9, "p");
            builder.AddAttribute(10, "class", "stat-number");
            builder.AddContent(11, Value);
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }
    }

    private class MoodItem : ComponentBase
    {
        [Parameter] public string Emoji { get; set; } = "🙂";
        [Parameter] public string Name { get; set; } = "";
        [Parameter] public int Count { get; set; } = 0;

        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "mood-item");
            builder.OpenElement(2, "span");
            builder.AddAttribute(3, "class", "mood-emoji");
            builder.AddContent(4, Emoji);
            builder.CloseElement();
            builder.OpenElement(5, "span");
            builder.AddAttribute(6, "class", "mood-name");
            builder.AddContent(7, Name);
            builder.CloseElement();
            builder.OpenElement(8, "span");
            builder.AddAttribute(9, "class", "mood-count");
            builder.AddContent(10, $"{Count} times");
            builder.CloseElement();
            builder.CloseElement();
        }
    }

    private class TagItem : ComponentBase
    {
        [Parameter] public string Text { get; set; } = "";
        [Parameter] public string Size { get; set; } = "md";

        protected override void BuildRenderTree(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"tag tag-{Size}");
            builder.AddContent(2, Text);
            builder.CloseElement();
        }
    }
}