@page "/search"
@inject IJournalService JournalService

@using Journal.Models
@using Journal.Services

<PageTitle>Search & Filter</PageTitle>

<div class="search-page">
    <div class="search-header">
        <h1>🔍 Search & Filter</h1>
        <p>Find specific journal entries quickly</p>
    </div>

    <div class="search-container">
        <div class="search-bar">
            <input type="text" class="search-input" placeholder="Search by title or content..."
                   @bind="searchQuery" @bind:event="oninput" />
            <button class="search-btn" @onclick="ApplyFilters">🔍 Search</button>
        </div>

        <div class="filters-section">
            <button class="toggle-filters" @onclick="() => showFilters = !showFilters">
                <span>@(showFilters ? "⚙️ Hide Filters" : "⚙️ Show Filters")</span>
            </button>

            @if (showFilters)
            {
                <div class="filters-panel">
                    <div class="filter-group">
                        <h3>📅 Date Range</h3>
                        <div class="date-inputs">
                            <div class="date-field">
                                <label>From</label>
                                <input type="date" class="form-control" @bind="fromDate" />
                            </div>
                            <div class="date-field">
                                <label>To</label>
                                <input type="date" class="form-control" @bind="toDate" />
                            </div>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>😊 Moods</h3>
                        <div class="mood-filters">
                            @foreach (var mood in moods)
                            {
                                <label class="checkbox-label">
                                    <input type="checkbox" @bind="moodSelections[mood]" />
                                    <span>@GetMoodEmoji(mood) @mood</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>🏷️ Tags</h3>
                        <div class="tag-filters">
                            @foreach (var tag in tags)
                            {
                                <label class="checkbox-label">
                                    <input type="checkbox" @bind="tagSelections[tag]" />
                                    <span>@tag</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="filter-actions">
                        <button class="btn-clear" @onclick="ClearFilters">Clear All</button>
                        <button class="btn-apply" @onclick="ApplyFilters">Apply Filters</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="results-section">
        <div class="results-header">
            <h2>Search Results</h2>
            <span class="results-count">@filteredEntries.Count entries found</span>
        </div>

        <div class="results-list">
            @if (!filteredEntries.Any())
            {
                <p>No entries found.</p>
            }
            else
            {
                @foreach (var e in filteredEntries)
                {
                    <div class="result-item" @onclick="() => ViewEntry(e.Id)">
                        <div class="result-header">
                            <h3>@(string.IsNullOrWhiteSpace(e.Title) ? "(No Title)" : e.Title)</h3>
                            <span class="result-date">@e.EntryDate.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                        </div>
                        <div class="result-meta">
                            <span class="mood-badge @(GetMoodClass(e.PrimaryMood))">
                                @GetMoodEmoji(e.PrimaryMood) @e.PrimaryMood
                            </span>
                            <span class="result-time">@e.CreatedDate.ToLocalTime().ToString("h:mm tt")</span>
                        </div>
                        <p class="result-excerpt">@GetExcerpt(e.Content)</p>
                        <div class="result-tags">
                            @if (!string.IsNullOrWhiteSpace(e.Tags))
                            {
                                foreach (var t in e.Tags.Split(','))
                                {
                                    <span class="tag">@t.Trim()</span>
                                }
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<JournalEntry> entries = new();
    private List<JournalEntry> filteredEntries = new();

    private string searchQuery = string.Empty;
    private bool showFilters = true;

    private DateTime? fromDate = null;
    private DateTime? toDate = null;

    private Dictionary<string, bool> moodSelections = new();
    private Dictionary<string, bool> tagSelections = new();

    private readonly string[] moods = new[]
    {
        "Happy","Excited","Relaxed","Grateful","Confident","Calm","Thoughtful",
        "Curious","Nostalgic","Bored","Sad","Angry","Stressed","Lonely","Anxious"
    };

    private readonly string[] tags = new[]
    {
        "Work","Health","Exercise","Family","Friends","Travel","Reading","Meditation","Personal Growth","Reflection"
    };

    protected override async Task OnInitializedAsync()
    {
        entries = await JournalService.GetEntriesAsync();

        // Initialize dictionaries
        foreach (var mood in moods) moodSelections[mood] = false;
        foreach (var tag in tags) tagSelections[tag] = false;

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        IEnumerable<JournalEntry> query = entries;

        // Search by title/content
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            query = query.Where(e =>
                (!string.IsNullOrWhiteSpace(e.Title) && e.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(e.Content) && e.Content.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            );
        }

        // Filter by date
        if (fromDate.HasValue)
            query = query.Where(e => e.EntryDate.Date >= fromDate.Value.Date);
        if (toDate.HasValue)
            query = query.Where(e => e.EntryDate.Date <= toDate.Value.Date);

        // Filter by moods
        var selectedMoods = moodSelections.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        if (selectedMoods.Any())
            query = query.Where(e => selectedMoods.Contains(e.PrimaryMood));

        // Filter by tags
        var selectedTags = tagSelections.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        if (selectedTags.Any())
            query = query.Where(e => !string.IsNullOrWhiteSpace(e.Tags) &&
                e.Tags.Split(',').Any(t => selectedTags.Contains(t.Trim()))
            );

        filteredEntries = query.OrderByDescending(e => e.EntryDate).ToList();
    }

    private void ClearFilters()
    {
        searchQuery = string.Empty;
        fromDate = null;
        toDate = null;

        foreach (var key in moodSelections.Keys.ToList()) moodSelections[key] = false;
        foreach (var key in tagSelections.Keys.ToList()) tagSelections[key] = false;

        ApplyFilters();
    }

    private string GetExcerpt(string content, int length = 150)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        return content.Length <= length ? content : content.Substring(0, length) + "...";
    }

    private string GetMoodEmoji(string mood) => mood switch
    {
        "Happy" => "😊",
        "Excited" => "🤗",
        "Relaxed" => "😌",
        "Grateful" => "🙏",
        "Confident" => "💪",
        "Calm" => "🧘",
        "Thoughtful" => "🤔",
        "Curious" => "🧐",
        "Nostalgic" => "🥺",
        "Bored" => "😐",
        "Sad" => "😢",
        "Angry" => "😠",
        "Stressed" => "😰",
        "Lonely" => "😔",
        "Anxious" => "😟",
        _ => ""
    };

    private string GetMoodClass(string mood) => mood switch
    {
        "Happy" or "Excited" or "Relaxed" or "Grateful" or "Confident" => "positive",
        "Sad" or "Angry" or "Stressed" or "Lonely" or "Anxious" => "negative",
        _ => "neutral"
    };

    private void ViewEntry(int id)
    {
        // Navigate to Timeline or Details page
        // e.g. NavigationManager.NavigateTo($"/timeline/{id}");
    }
}
