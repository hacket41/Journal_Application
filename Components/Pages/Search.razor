@page "/search"

<PageTitle>Search & Filter</PageTitle>

<div class="search-page">
    <div class="search-header">
        <h1>🔍 Search & Filter</h1>
        <p>Find specific journal entries quickly</p>
    </div>

    <div class="search-container">
        <div class="search-bar">
            <input type="text" class="search-input" placeholder="Search by title or content..." />
            <button class="search-btn">🔍 Search</button>
        </div>

        <div class="filters-section">
            <button class="toggle-filters">
                <span>⚙️ Show Filters</span>
            </button>

            <div class="filters-panel">
                <div class="filter-group">
                    <h3>📅 Date Range</h3>
                    <div class="date-inputs">
                        <div class="date-field">
                            <label>From</label>
                            <input type="date" class="form-control" value="2025-01-01" />
                        </div>
                        <div class="date-field">
                            <label>To</label>
                            <input type="date" class="form-control" value="2025-12-19" />
                        </div>
                    </div>
                </div>

                <div class="filter-group">
                    <h3>😊 Moods</h3>
                    <div class="mood-filters">
                        <div class="mood-category">
                            <h4>Positive</h4>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>😊 Happy</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>🤗 Excited</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>😌 Relaxed</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>🙏 Grateful</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>💪 Confident</span>
                            </label>
                        </div>

                        <div class="mood-category">
                            <h4>Neutral</h4>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>🧘 Calm</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>🤔 Thoughtful</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>🧐 Curious</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>🥺 Nostalgic</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>😐 Bored</span>
                            </label>
                        </div>

                        <div class="mood-category">
                            <h4>Negative</h4>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>😢 Sad</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>😠 Angry</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>😰 Stressed</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>😔 Lonely</span>
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" />
                                <span>😟 Anxious</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="filter-group">
                    <h3>🏷️ Tags</h3>
                    <div class="tag-filters">
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Work</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Health</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Exercise</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Family</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Friends</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Travel</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Reading</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Meditation</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Personal Growth</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" />
                            <span>Reflection</span>
                        </label>
                    </div>
                </div>

                <div class="filter-actions">
                    <button class="btn-clear">Clear All</button>
                    <button class="btn-apply">Apply Filters</button>
                </div>
            </div>
        </div>
    </div>

    <div class="results-section">
        <div class="results-header">
            <h2>Search Results</h2>
            <span class="results-count">42 entries found</span>
        </div>

        <div class="results-list">
            <div class="result-item">
                <div class="result-header">
                    <h3>A Peaceful Thursday</h3>
                    <span class="result-date">December 19, 2025</span>
                </div>
                <div class="result-meta">
                    <span class="mood-badge positive">😌 Relaxed</span>
                    <span class="result-time">3:45 PM</span>
                </div>
                <p class="result-excerpt">
                    Today was incredibly <mark>peaceful</mark>. I took some time to meditate in
                    the morning, which really set the tone for the rest of the day...
                </p>
                <div class="result-tags">
                    <span class="tag">Meditation</span>
                    <span class="tag">Self-care</span>
                    <span class="tag">Reflection</span>
                </div>
            </div>

            <div class="result-item">
                <div class="result-header">
                    <h3>Midweek Momentum</h3>
                    <span class="result-date">December 18, 2025</span>
                </div>
                <div class="result-meta">
                    <span class="mood-badge positive">😊 Happy</span>
                    <span class="result-time">8:30 PM</span>
                </div>
                <p class="result-excerpt">
                    Wednesday energy was strong today! Got through most of my to-do list and even
                    had time for a nice walk in the park...
                </p>
                <div class="result-tags">
                    <span class="tag">Exercise</span>
                    <span class="tag">Nature</span>
                </div>
            </div>

            <div class="result-item">
                <div class="result-header">
                    <h3>Reflections on Growth</h3>
                    <span class="result-date">December 17, 2025</span>
                </div>
                <div class="result-meta">
                    <span class="mood-badge neutral">🤔 Thoughtful</span>
                    <span class="result-time">10:15 PM</span>
                </div>
                <p class="result-excerpt">
                    Been thinking a lot about personal growth lately. Looking back at where I was
                    a year ago, I can see how much I've changed...
                </p>
                <div class="result-tags">
                    <span class="tag">Personal Growth</span>
                    <span class="tag">Reflection</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .search-page {
        padding: 2rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    .search-header {
        margin-bottom: 2rem;
    }

        .search-header h1 {
            margin: 0 0 0.5rem 0;
            color: #333;
        }

        .search-header p {
            color: #666;
            font-size: 1.1rem;
        }

    .search-container {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

    .search-bar {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .search-input {
        flex: 1;
        padding: 1rem 1.5rem;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        font-size: 1.1rem;
        transition: border-color 0.2s;
    }

        .search-input:focus {
            outline: none;
            border-color: #5e3a8e;
        }

    .search-btn {
        padding: 1rem 2rem;
        background: linear-gradient(135deg, #5e3a8e, #4a2c6d);
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .search-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(94, 58, 142, 0.3);
        }

    .filters-section {
        border-top: 2px solid #f3f4f6;
        padding-top: 1.5rem;
    }

    .toggle-filters {
        padding: 0.75rem 1.5rem;
        background: #f9fafb;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        width: 100%;
        text-align: left;
        transition: all 0.2s;
    }

        .toggle-filters:hover {
            background: #f3f4f6;
        }

    .filters-panel {
        margin-top: 1.5rem;
        display: grid;
        gap: 2rem;
    }

    .filter-group h3 {
        margin: 0 0 1rem 0;
        color: #333;
        font-size: 1.1rem;
    }

    .date-inputs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .date-field label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #555;
        font-size: 0.9rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #e5e7eb;
        border-radius: 8px;
        font-size: 1rem;
    }

        .form-control:focus {
            outline: none;
            border-color: #5e3a8e;
        }

    .mood-filters {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .mood-category h4 {
        margin: 0 0 0.75rem 0;
        color: #555;
        font-size: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #f3f4f6;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem;
        cursor: pointer;
        border-radius: 6px;
        transition: background 0.2s;
    }

        .checkbox-label:hover {
            background: #f9fafb;
        }

        .checkbox-label input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

    .tag-filters {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 0.5rem;
    }

    .filter-actions {
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
        padding-top: 1.5rem;
        border-top: 2px solid #f3f4f6;
    }

    .btn-clear {
        padding: 0.75rem 1.5rem;
        background: #f3f4f6;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-clear:hover {
            background: #e5e7eb;
        }

    .btn-apply {
        padding: 0.75rem 2rem;
        background: #5e3a8e;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-apply:hover {
            background: #4a2c6d;
        }

    .results-section {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #f3f4f6;
    }

        .results-header h2 {
            margin: 0;
            color: #333;
        }

    .results-count {
        color: #666;
        font-size: 0.95rem;
    }

    .results-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .result-item {
        padding: 1.5rem;
        background: #f9fafb;
        border-radius: 8px;
        transition: all 0.2s;
        cursor: pointer;
    }

        .result-item:hover {
            background: #f3f4f6;
            transform: translateX(4px);
        }

    .result-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.75rem;
    }

        .result-header h3 {
            margin: 0;
            color: #333;
            font-size: 1.2rem;
        }

    .result-date {
        color: #666;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .result-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .mood-badge {
        padding: 0.4rem 0.75rem;
        border-radius: 16px;
        font-size: 0.85rem;
        font-weight: 600;
    }

        .mood-badge.positive {
            background: #d1fae5;
            color: #065f46;
        }

        .mood-badge.neutral {
            background: #fef3c7;
            color: #92400e;
        }

    .result-time {
        color: #666;
        font-size: 0.85rem;
    }

    .result-excerpt {
        color: #555;
        line-height: 1.6;
        margin-bottom: 1rem;
    }

        .result-excerpt mark {
            background: #fef3c7;
            padding: 0.1rem 0.3rem;
            border-radius: 3px;
        }

    .result-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        padding: 0.4rem 0.75rem;
        background: white;
        color: #5e3a8e;
        border-radius: 16px;
        font-size: 0.85rem;
        font-weight: 500;
    }
</style>