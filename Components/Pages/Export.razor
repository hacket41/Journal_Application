@page "/export"
@using Journal.Models
@using Journal.Services
@inject ExportService ExportService
@inject IJSRuntime JSRuntime

<div class="container-fluid p-4">
    <h2 class="mb-4">Export Journals</h2>

    <!-- Date Range Selection -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Select Date Range</h5>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">From:</label>
                    <input type="date" class="form-control" @bind="startDate" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">To:</label>
                    <input type="date" class="form-control" @bind="endDate" />
                </div>
            </div>

            <button class="btn btn-primary" @onclick="LoadPreview" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Load Preview
            </button>
        </div>
    </div>

    <!-- Preview Section -->
    @if (showPreview)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Preview</h5>
                <p class="text-muted">@previewEntries.Count @(previewEntries.Count == 1 ? "entry" : "entries") found</p>

                @if (previewEntries.Any())
                {
                    <div class="preview-list" style="max-height: 400px; overflow-y: auto;">
                        @foreach (var entry in previewEntries)
                        {
                            <div class="card mb-2">
                                <div class="card-body p-3">
                                    <h6 class="card-subtitle mb-2">@entry.Date.ToString("dddd, MMMM d, yyyy")</h6>
                                    @if (!string.IsNullOrEmpty(entry.Title))
                                    {
                                        <p class="mb-1"><strong>@entry.Title</strong></p>
                                    }
                                    <small class="text-muted">
                                        <span class="badge bg-info me-1">@entry.PrimaryMood</span>
                                        @entry.WordCount words
                                    </small>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-success" @onclick="ExportToPdf" disabled="@isExporting">
                            @if (isExporting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Export to HTML/PDF
                        </button>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">No entries found in this date range.</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private DateTime startDate = DateTime.Today.AddDays(-30);
    private DateTime endDate = DateTime.Today;
    private List<JournalEntry> previewEntries = new();
    private bool showPreview = false;
    private bool isLoading = false;
    private bool isExporting = false;

    private async Task LoadPreview()
    {
        if (startDate > endDate)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Start date must be before end date.");
            return;
        }

        isLoading = true;
        try
        {
            previewEntries = await ExportService.GetEntriesForExportAsync(startDate, endDate);
            showPreview = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading preview: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ExportToPdf()
    {
        isExporting = true;
        try
        {
            var html = await ExportService.GenerateHtmlForDownloadAsync(startDate, endDate);
            var fileName = $"Journal_{startDate:yyyy-MM-dd}_to_{endDate:yyyy-MM-dd}.html";

            // Download the file
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, html);

            await JSRuntime.InvokeVoidAsync("alert", $"Export successful! File saved as {fileName}");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error exporting: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }
}